* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.java text eol=lf
*.ps1 text eol=crlf
*.apk binary
*.exe binary
*.arsc binary
*.rc2anim binary
*.dll binary
*.idsig binary
*.zip binary
# Hash-pinned payloads/manifests must keep exact upstream/build bytes on every OS.
artifacts/translation-engine/** -text -whitespace
assets/translation/** -text -whitespace
assets/auto-history/** -text -whitespace
# Preserve the published bytes covered by dist/SHA256SUMS.txt.
dist/** -text -whitespace
dist/RC2-TuDong-Patch-*.exe filter=lfs diff=lfs merge=lfs -text
